# 复制本文件为 .env，再填入你自己的值。.env 不会被提交到 GitHub。
# 大模型 API 使用 OpenAI 兼容格式：换模型/服务商只需改下面三行。

# ── 方案 A：本地模型（Ollama，免费）──
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:30b

# ── 方案 B：OpenAI（付费）──
# LLM_API_KEY=sk-your-key-here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=your-model-id   # 运行 python scripts/list_models.py 查看可用 ID

# SEC 要求每个请求带上 User-Agent（姓名 + 邮箱），否则会被拒绝
SEC_USER_AGENT=Your Name your_email@example.com

# embedding 模型（M3 RAG 用）。OpenAI: text-embedding-3-small；本地 Ollama: bge-m3
EMBED_MODEL=text-embedding-3-small
